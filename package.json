{
  "name": "dsh-dock",
  "version": "0.2.0",
  "description": "DeepSeek Harness 功能坞插件（dsh-dock）：侧栏入口按钮 + 功能弹层 + 设置页管理面板，统一注册、开关所有小功能（模型余额已接入，Token 用量记录、任务动画等按路线图接入）。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dock",
    "function-dock",
    "功能坞",
    "panel",
    "hub",
    "web",
    "dashboard"
  ],
  "author": "wycto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wycto/dsh-dock.git"
  },
  "homepage": "https://github.com/wycto/dsh-dock",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  }
}