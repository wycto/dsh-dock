{
  "name": "dsh-dock",
  "version": "0.1.0",
  "description": "DeepSeek Harness 功能中枢插件：用一张管理面板统一注册、开关所有小功能（模型余额、Token 用量记录、任务动画等）。0.1.0 为基础框架版本，功能接入路线见 README。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "panel",
    "hub",
    "feature-hub",
    "web",
    "dashboard"
  ],
  "author": "wycto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wycto/dsh-dock.git"
  },
  "homepage": "https://github.com/wycto/dsh-dock",
  "publishConfig": {
    "access": "public"
  }
}