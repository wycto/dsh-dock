{
  "name": "dsh-dock",
  "version": "0.9.3",
  "description": "DeepSeek Harness 功能坞插件（dsh-dock）：模块化功能中枢——每个功能一个 features/ 模块（可单独提取成包发布，又可经 dockBridge 装回面板）。含用量记录（LLM 调用记账/费用统计）、模型设置、图片理解代理、模型余额、任务动画（19 种运行动画 + 桌面伙伴 3D 场景、完成/需确认通知与提示音、钉钉/飞书推送，开关独立、配置持久化）；侧栏入口 + 可拖拽弹窗（最大化/最小化/缩放）。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "src/",
    "features/",
    "cordis.patch.yml",
    "screenshots"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dock",
    "function-dock",
    "功能坞",
    "panel",
    "hub",
    "web",
    "dashboard"
  ],
  "author": "wycto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wycto/dsh-dock.git"
  },
  "homepage": "https://github.com/wycto/dsh-dock",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "qrcode": "^1.5.4"
  }
}
