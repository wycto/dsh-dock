{
  "name": "dsh-dock",
  "version": "0.3.0",
  "description": "DeepSeek Harness 功能坞插件（dsh-dock）：侧栏入口 + 居中可拖拽弹窗（最大化/最小化/缩放）+ 模型设置（输入类型/思考强度，写回官方配置热生效）+ 模型余额 + 设置页管理面板。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dock",
    "function-dock",
    "功能坞",
    "panel",
    "hub",
    "web",
    "dashboard"
  ],
  "author": "wycto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wycto/dsh-dock.git"
  },
  "homepage": "https://github.com/wycto/dsh-dock",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}